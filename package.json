{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run lang:js && vite",
        "build": "npm run lang:js && vite build",
        "lang:js": "php artisan lang:js --no-lib && node -e \"const fs=require('fs'); const file='resources/js/messages.js'; fs.writeFileSync(file, fs.readFileSync(file, 'utf8').replace('module.exports =', 'export default'));\""
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.15.0",
        "concurrently": "^9.0.1",
        "glob": "^13.0.6",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "sass": "^1.98.0",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@cloudinary/url-gen": "^1.22.0",
        "@cloudinary/vue": "^1.13.4",
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "chart.js": "^4.5.1",
        "datatables.net": "^2.3.7",
        "datatables.net-bs5": "^2.3.7",
        "flag-icons": "^7.5.0",
        "jquery": "^3.7.1",
        "lang.js": "^1.1.14",
        "pinia": "^3.0.4",
        "select2": "^4.1.0-rc.0",
        "select2-bootstrap4-theme": "^1.0.0",
        "swiper": "^10.3.1",
        "vue": "^3.5.32",
        "vue-router": "^5.0.4"
    }
}
